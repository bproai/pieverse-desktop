# PieVerse Desktop Python Configuration Template
# Copy this file to .cargo/config.toml and update the paths to match your Python installation

# Configuration for x86_64 macOS
[target.x86_64-apple-darwin]
rustflags = [
  # For system Python (adjust version number as needed)
  "-C", "link-arg=-L/Library/Frameworks/Python.framework/Versions/3.9/lib",
  "-C", "link-arg=-lpython3.9",
  "-C", "link-arg=-Wl,-rpath,/Library/Frameworks/Python.framework/Versions/3.9/lib",
  
  # For Homebrew Python (uncomment and adjust if using Homebrew)
  # "-C", "link-arg=-L/opt/homebrew/opt/python@3.9/lib",
  # "-C", "link-arg=-lpython3.9",
  # "-C", "link-arg=-Wl,-rpath,/opt/homebrew/opt/python@3.9/lib",
  
  # For Anaconda/Miniconda (uncomment and adjust if using Anaconda)
  # "-C", "link-arg=-L/path/to/anaconda/lib",
  # "-C", "link-arg=-lpython3.9",
  # "-C", "link-arg=-Wl,-rpath,/path/to/anaconda/lib",
  
  # Default paths (don't change these)
  "-C", "link-arg=-Wl,-rpath,@executable_path/../Frameworks",
  "-C", "link-arg=-Wl,-rpath,/usr/lib"
]

# Configuration for ARM macOS (M1/M2/M3)
[target.aarch64-apple-darwin]
rustflags = [
  # For system Python (adjust version number as needed)
  "-C", "link-arg=-L/Library/Frameworks/Python.framework/Versions/3.9/lib",
  "-C", "link-arg=-lpython3.9",
  "-C", "link-arg=-Wl,-rpath,/Library/Frameworks/Python.framework/Versions/3.9/lib",
  
  # For Homebrew Python (uncomment and adjust if using Homebrew)
  # "-C", "link-arg=-L/opt/homebrew/opt/python@3.9/lib",
  # "-C", "link-arg=-lpython3.9",
  # "-C", "link-arg=-Wl,-rpath,/opt/homebrew/opt/python@3.9/lib",
  
  # For Anaconda/Miniconda (uncomment and adjust if using Anaconda)
  # "-C", "link-arg=-L/opt/homebrew/anaconda3/lib",
  # "-C", "link-arg=-lpython3.12",
  # "-C", "link-arg=-Wl,-rpath,/opt/homebrew/anaconda3/lib",
  
  # Default paths (don't change these)
  "-C", "link-arg=-Wl,-rpath,@executable_path/../Frameworks",
  "-C", "link-arg=-Wl,-rpath,/usr/lib"
]

# Configuration for Windows
[target.x86_64-pc-windows-msvc]
rustflags = [
  # For Python installed from python.org or Microsoft Store
  # Adjust paths and version numbers as needed
  "-C", "link-arg=/LIBPATH:C:\\Python39\\libs",
  
  # For Anaconda (uncomment and adjust if using Anaconda)
  # "-C", "link-arg=/LIBPATH:C:\\Users\\username\\Anaconda3\\libs",
]

# Configuration for Linux
[target.x86_64-unknown-linux-gnu]
rustflags = [
  # For system Python (adjust version and path as needed)
  "-C", "link-arg=-L/usr/lib/python3.9/config-3.9-x86_64-linux-gnu",
  "-C", "link-arg=-lpython3.9",
  "-C", "link-arg=-Wl,-rpath=/usr/lib/python3.9/config-3.9-x86_64-linux-gnu",
  
  # For Anaconda (uncomment and adjust if using Anaconda)
  # "-C", "link-arg=-L/home/username/anaconda3/lib",
  # "-C", "link-arg=-lpython3.9",
  # "-C", "link-arg=-Wl,-rpath=/home/username/anaconda3/lib",
]