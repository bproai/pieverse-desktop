{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PieVerse",
  "version": "1.0.0",
  "identifier": "com.pieverse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PieVerse",
        "width": 800,
        "height": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' microphone: http: https: mediadevices: blob: asset:; connect-src 'self' http: http://localhost:3030 https://www.google.com https://*.googleapis.com https://speech.googleapis.com wss://*.speech.googleapis.com https: mediadevices: ipc: tauri:; img-src 'self' data: asset: s3: tauri: http://s3.localhost https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:;"      
    },
    "trayIcon": {
      "iconPath": "icons/256x256.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "src/python_scripts/*"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "protocol": {
      "asset": true,
      "assetScope": ["**"],
      "s3": true,
      "tauri": true
    },
    "webview": {
      "allowedMediaPermissions": ["microphone", "audioCapture", "audioOutput"],
      "permissions": ["microphone", "audioOutput"],
      "withGlobalTauri": true 
    },
    "microphone": {
      "enabled": true
    },
    "updater": {
      "active": false,
      "endpoints": ["https://reasonone.ai/updates"],
      "dialog": true
    }
  }
}