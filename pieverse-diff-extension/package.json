{
  "name": "pieverse-diff-extension",
  "publisher": "ReasonONELLC",
  "displayName": "PieVerse VS Code Extension",
  "description": "VS Code Extension Companion for PieVerse Desktop App",
  "icon": "icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pieverse-diff.focus",
        "title": "Focus PieVerse Sidebar"
      },
      {
        "command": "pieverse-diff.connect",
        "title": "Connect to PieVerse"
      },
      {
        "command": "pieverse-diff.showDiff",
        "title": "Show PieVerse Diff"
      },
      {
        "command": "pieverse-diff.setWebSocketUrl",
        "title": "Set PieVerse WebSocket URL"
      },
      {
        "command": "pieverse-diff.clearMessages",
        "title": "Clear PieVerse Messages"
      },
      {
        "command": "pieverse-diff.acceptChanges",
        "title": "Accept PieVerse Suggested Changes"
      },
      {
        "command": "pieverse-diff.rejectChanges",
        "title": "Reject PieVerse Suggested Changes"
      },
      {
        "command": "pieverse-diff.selectivelyApplyChanges",
        "title": "Apply PieVerse Changes Selectively"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pieverse-diff",
          "title": "PieVerse",
          "icon": "resources/pieverse-icon.svg"
        }
      ]
    },
    "views": {
      "pieverse-diff": [
        {
          "id": "pieverseDiffView",
          "name": "PieVerse",
          "type": "webview",
          "icon": "resources/pieverse-icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "PieVerse Diff",
      "properties": {
        "pieverse-diff.websocketUrl": {
          "type": "string",
          "default": "ws://localhost:3001",
          "description": "WebSocket URL for connecting to PieVerse server"
        },
        "pieverse-diff.createBackupFiles": {
          "type": "boolean",
          "default": false,
          "description": "Create backup files when accepting changes (set to false if you use version control like Git)"
        },
        "pieverse-diff.autoOpenDiff": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open diff view when receiving suggested changes"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty -v 34.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.24",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.8",
    "electron": "34.2.0",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.13.0"
  }
}
